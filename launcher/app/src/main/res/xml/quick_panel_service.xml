<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes of Google TV Home (to keep its home activity off screen) and of the Assistant (whose
     results Google TV Home shows, and must stay), global actions and key filtering for the Home key
     (every other key is handed straight back): no window content, no events from any other app. Key
     filtering depends only on flagRequestFilterKeyEvents and canRequestFilterKeyEvents, not on the
     event types. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.katniss"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:description="@string/quick_panel_description" />
